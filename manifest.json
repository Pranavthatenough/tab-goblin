{
  "manifest_version": 3,
  "name": "Tab Goblin",
  "version": "1.0.0",
  "description": "A goblin eats the tabs you ignored. It puts them to sleep without closing them, never touches a half-filled form, and saves sessions you can restore.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tab Goblin",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "popup/popup.html",
  "permissions": ["tabs", "storage", "alarms", "scripting", "favicon"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/form-guard.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
